# API Gateway / backend base. Must end with /v1.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/v1
# API_BASE_URL=http://localhost:8080/v1

# API Gateway key (x-api-key)
# API_KEY=
# NEXT_PUBLIC_API_KEY=

# Role sent as X-Role (used when JWT claims are absent)
# API_ROLE=ADMIN
# NEXT_PUBLIC_API_ROLE=ADMIN

# Credentials for Bearer JWT (POST /auth/login or POST /auth/session)
# API_USERNAME=admin
# API_PASSWORD=admin321
# STAFF_USERNAME=admin
# STAFF_PASSWORD=admin321

# Optional: pin a Bearer token instead of logging in
# API_BEARER_TOKEN=
# NEXT_PUBLIC_API_BEARER_TOKEN=

# LOG_BACKEND_CURL=true
